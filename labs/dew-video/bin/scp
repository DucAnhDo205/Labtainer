#!/usr/bin/env bash
set -euo pipefail

while [ "$#" -gt 0 ]; do
    case "$1" in
        -*) shift ;;
        *) break ;;
    esac
done

if [ "$#" -lt 2 ]; then
    echo "Usage: scp <source> <user@host:/path/>" >&2
    exit 2
fi

src="$1"
dest="${@: -1}"
base="$(basename "$src")"

case "$dest" in
    *tester:*|*verifier:*)
        cp "$src" "/dew-xfer/$base"
        ;;
    *)
        echo "This lab supports copying files to tester/verifier only." >&2
        exit 2
        ;;
esac
