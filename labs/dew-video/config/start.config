GLOBAL_SETTINGS
    GRADE_CONTAINER dew-video
    HOST_HOME_XFER labtainer_xfer/
    LAB_MASTER_SEED dew-video_2026_master_seed
    COLLECT_DOCS YES

NETWORK local-net
    MASK 172.25.10.0/24
    GATEWAY 172.25.10.1

CONTAINER dew-video
    TERMINALS 1
    REGISTRY vhtuan2004
    IMAGE_NAME vp9-padding-stego.ubuntu1.student
    USER ubuntu
    PASSWORD ubuntu
    DOCKER_ARGS -v /home/student/labtainer/trunk/labs/dew-video/dew-video/attack.py:/home/ubuntu/attack.py:ro -v /home/student/labtainer/trunk/labs/dew-video/dew-video/dew_core.py:/home/ubuntu/dew_core.py:ro -v /home/student/labtainer/trunk/labs/dew-video/dew-video/dew_embed.py:/home/ubuntu/dew_embed.py:ro -v /home/student/labtainer/trunk/labs/dew-video/dew-video/dew_extract.py:/home/ubuntu/dew_extract.py:ro -v /home/student/labtainer/trunk/labs/dew-video/dew-video/instructions.txt:/home/ubuntu/instructions.txt:ro -v /home/student/labtainer/trunk/labs/dew-video/dew-video/make_cover.py:/home/ubuntu/make_cover.py:ro -v /home/student/labtainer/trunk/labs/dew-video/dew-video/quality.py:/home/ubuntu/quality.py:ro -v /home/student/labtainer/trunk/labs/dew-video/dew-video/Student.py:/home/ubuntu/Student.py:ro -v /home/student/labtainer/trunk/labs/dew-video/dew-video/submit_dew.py:/home/ubuntu/submit_dew.py:ro -v /home/student/labtainer/trunk/labs/dew-video/bin/scp:/home/ubuntu/.local/bin/scp:ro -v /tmp/dew-video-xfer:/dew-xfer
    local-net 172.25.10.10
    ADD-HOST tester:172.25.10.20

CONTAINER tester
    TERMINALS 1
    REGISTRY vhtuan2004
    IMAGE_NAME vp9-padding-stego.ubuntu1.student
    USER ubuntu
    PASSWORD ubuntu
    DOCKER_ARGS -v /home/student/labtainer/trunk/labs/dew-video/tester/attack.py:/home/ubuntu/attack.py:ro -v /home/student/labtainer/trunk/labs/dew-video/tester/dew_core.py:/home/ubuntu/dew_core.py:ro -v /home/student/labtainer/trunk/labs/dew-video/tester/dew_extract.py:/home/ubuntu/dew_extract.py:ro -v /home/student/labtainer/trunk/labs/dew-video/tester/instructions.txt:/home/ubuntu/instructions.txt:ro -v /home/student/labtainer/trunk/labs/dew-video/tester/run_tests.sh:/home/ubuntu/run_tests.sh:ro -v /home/student/labtainer/trunk/labs/dew-video/tester/Student.py:/home/ubuntu/Student.py:ro -v /tmp/dew-video-xfer:/dew-xfer
    local-net 172.25.10.20
    ADD-HOST dew-video:172.25.10.10
