GLOBAL_SETTINGS
    GRADE_CONTAINER dew-video
    HOST_HOME_XFER labtainer_xfer/
    LAB_MASTER_SEED dew-video_2026_master_seed
    COLLECT_DOCS YES

NETWORK local-net
    MASK 172.25.10.0/24
    GATEWAY 172.25.10.1

CONTAINER dew-video
    TERMINALS 1
    REGISTRY doanhduc536
    USER ubuntu
    PASSWORD ubuntu
    local-net 172.25.10.10
    ADD-HOST tester:172.25.10.20

CONTAINER tester
    TERMINALS 1
    REGISTRY doanhduc536
    USER ubuntu
    PASSWORD ubuntu
    local-net 172.25.10.20
    ADD-HOST dew-video:172.25.10.10
