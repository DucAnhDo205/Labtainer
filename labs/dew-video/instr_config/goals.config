# goals.config
#
# Public checkwork goals for the DEW video steganography lab.

# DOC: Cover video was created and checked on dew-video.
cover = boolean : _cover_created and True

# DOC: The expected 152 DEW watermark bits were embedded.
embed = boolean : _embed_bits and True

# DOC: The hidden message extracts as LABTAINERS-DEW-2026 on dew-video.
extract = boolean : _extract_ok and True

# DOC: The watermarked video keeps PSNR at or above 30 dB.
psnr = boolean : _psnr_ok and True

# DOC: Tester decodes the copied watermarked video.
tester_original = boolean : _tester_original and True

# DOC: Tester decodes the watermarked video after the mild attack.
tester_attacked = boolean : _tester_attacked and True

# DOC: All DEW video lab requirements are complete.
complete = boolean : _tester_original and _tester_attacked and True
