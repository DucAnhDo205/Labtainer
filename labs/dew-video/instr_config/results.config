# results.config
#
# Automated assessment for the DEW video steganography Labtainer.

# Standard grading results from the student workstation.
_cover_created = dew-video:submit_dew.py.stdout : CONTAINS : COVER_OK=Y
_embed_bits = dew-video:submit_dew.py.stdout : CONTAINS : EMBED_BITS=152
_extract_ok = dew-video:submit_dew.py.stdout : CONTAINS : EXTRACT_OK=Y
_psnr_ok = dew-video:submit_dew.py.stdout : CONTAINS : PSNR_OK=Y

# Standard grading results from the tester workstation.
_tester_original = tester:run_tests.sh.stdout : CONTAINS : VERIFY_ORIGINAL=Y
_tester_attacked = tester:run_tests.sh.stdout : CONTAINS : VERIFY_ATTACKED=Y
