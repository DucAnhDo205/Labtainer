# results.config
#
# Automated assessment for the DEW evidence-video Labtainer.

# Standard grading results from the student workstation.
_cover_created = demo:submit_dew.stdout : CONTAINS : COVER_OK=Y
_embed_bits = demo:submit_dew.stdout : CONTAINS : EMBED_BITS=136
_extract_ok = demo:submit_dew.stdout : CONTAINS : EXTRACT_OK=Y
_psnr_ok = demo:submit_dew.stdout : CONTAINS : PSNR_OK=Y

# Standard grading results from the tester workstation.
_tester_original = tester:run_tests.stdout : CONTAINS : VERIFY_ORIGINAL=Y
_tester_attacked = tester:run_tests.stdout : CONTAINS : VERIFY_ATTACKED=Y

# Current-state checkwork feedback.  Students see these messages when a
# checkwork item is still missing or false.
#CHECK_TRUE: cover.dwv was not verified. On demo, run: python make_cover.py; python submit_dew.py
cw_cover_created = demo:submit_dew.stdout : CONTAINS : COVER_OK=Y
#CHECK_TRUE: The expected 136 watermark bits were not embedded. On demo, rerun python submit_dew.py.
cw_embed_bits = demo:submit_dew.stdout : CONTAINS : EMBED_BITS=136
#CHECK_TRUE: The hidden DEW evidence seal did not extract correctly on demo.
cw_extract_ok = demo:submit_dew.stdout : CONTAINS : EXTRACT_OK=Y
#CHECK_TRUE: The watermarked video PSNR is below the required threshold.
cw_psnr_ok = demo:submit_dew.stdout : CONTAINS : PSNR_OK=Y
#CHECK_TRUE: Tester did not decode the original watermarked video. Copy watermarked.dwv to tester and run ./run_tests.sh watermarked.dwv 17 7301.
cw_tester_original = tester:run_tests.stdout : CONTAINS : VERIFY_ORIGINAL=Y
#CHECK_TRUE: Tester did not decode the attacked video. Rerun ./run_tests.sh watermarked.dwv 17 7301 on tester.
cw_tester_attacked = tester:run_tests.stdout : CONTAINS : VERIFY_ATTACKED=Y
#CHECK_OK: All DEW evidence-video checkwork items pass.
