# goals.config
#
# Final instructor-facing goals for the DEW evidence-video lab.

# DOC: Student created the cover video, embedded the DEW watermark, extracted
# the expected message, and kept visual distortion within the PSNR threshold.
dew_evidence_demo_complete = boolean : ( _cover_created and _embed_bits and _extract_ok and _psnr_ok )

# DOC: Tester workstation validated both the original watermarked video and
# the compression-like attacked video.
dew_evidence_tester_complete = boolean : ( _tester_original and _tester_attacked )

# DOC: Full DEW video Labtainer completion. This is true only when all student
# and tester checks are satisfied.
dew_evidence_lab_complete = boolean : ( dew_evidence_demo_complete and dew_evidence_tester_complete )
