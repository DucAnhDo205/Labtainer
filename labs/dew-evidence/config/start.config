GLOBAL_SETTINGS
    GRADE_CONTAINER demo
    HOST_HOME_XFER labtainer_xfer/
    LAB_MASTER_SEED dew_evidence_2026_master_seed
    COLLECT_DOCS YES

NETWORK local-net
    MASK 172.25.20.0/24
    GATEWAY 172.25.20.1

CONTAINER demo
    TERMINALS 1
    REGISTRY vhtuan2004
    IMAGE_NAME vp9-padding-stego.ubuntu1.student
    USER ubuntu
    PASSWORD ubuntu
    DOCKER_ARGS -v /home/student/labtainer/trunk/labs/dew-evidence/demo/attack.py:/home/ubuntu/attack.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/demo/dew_core.py:/home/ubuntu/dew_core.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/demo/dew_embed.py:/home/ubuntu/dew_embed.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/demo/dew_extract.py:/home/ubuntu/dew_extract.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/demo/instructions.txt:/home/ubuntu/instructions.txt:ro -v /home/student/labtainer/trunk/labs/dew-evidence/demo/make_cover.py:/home/ubuntu/make_cover.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/demo/quality.py:/home/ubuntu/quality.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/demo/Student.py:/home/ubuntu/Student.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/demo/submit_dew.py:/home/ubuntu/submit_dew.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/bin/scp:/home/ubuntu/.local/bin/scp:ro -v /tmp/dew-evidence-xfer:/dew-xfer
    local-net 172.25.20.10
    ADD-HOST tester:172.25.20.20

CONTAINER tester
    TERMINALS 1
    REGISTRY vhtuan2004
    IMAGE_NAME vp9-padding-stego.ubuntu1.student
    USER ubuntu
    PASSWORD ubuntu
    DOCKER_ARGS -v /home/student/labtainer/trunk/labs/dew-evidence/tester/attack.py:/home/ubuntu/attack.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/tester/dew_core.py:/home/ubuntu/dew_core.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/tester/dew_extract.py:/home/ubuntu/dew_extract.py:ro -v /home/student/labtainer/trunk/labs/dew-evidence/tester/instructions.txt:/home/ubuntu/instructions.txt:ro -v /home/student/labtainer/trunk/labs/dew-evidence/tester/run_tests.sh:/home/ubuntu/run_tests.sh:ro -v /home/student/labtainer/trunk/labs/dew-evidence/tester/Student.py:/home/ubuntu/Student.py:ro -v /tmp/dew-evidence-xfer:/dew-xfer
    local-net 172.25.20.20
    ADD-HOST demo:172.25.20.10
