#!/usr/bin/env python3
import io
import os
import sys
import zipfile


def _read_text_from_zip(zf, name, limit=30000):
    data = zf.read(name)
    if len(data) > limit:
        data = data[:limit] + b"\n... truncated ...\n"
    return data.decode("utf-8", errors="replace")


def main():
    if len(sys.argv) < 2:
        return 0

    lab_path = sys.argv[1]
    xfer_dir = os.path.dirname(lab_path)
    base = os.path.basename(lab_path)
    stem = base[:-4] if base.endswith(".lab") else base

    log_path = os.path.join(xfer_dir, stem + ".log")
    with open(log_path, "w", encoding="utf-8") as out:
        out.write("DEW audit Labtainer process log\n")
        out.write("Artifact: %s\n\n" % base)

        try:
            outer = zipfile.ZipFile(lab_path, "r")
        except Exception as exc:
            out.write("ERROR: unable to read lab artifact: %s\n" % exc)
            return 0

        out.write("Files in artifact:\n")
        for name in outer.namelist():
            out.write("  %s\n" % name)

        out.write("\nCollected command/result output:\n")
        for outer_name in outer.namelist():
            if not outer_name.endswith(".zip"):
                continue
            try:
                nested = zipfile.ZipFile(io.BytesIO(outer.read(outer_name)), "r")
            except Exception:
                continue
            out.write("\n===== %s =====\n" % outer_name)
            for inner_name in nested.namelist():
                lname = inner_name.lower()
                if (
                    lname.endswith(".stdout")
                    or ".stdout." in lname
                    or lname.endswith(".stderr")
                    or ".stderr." in lname
                    or lname.endswith(".bash_history")
                    or lname.endswith("instructions.txt")
                ):
                    out.write("\n--- %s ---\n" % inner_name)
                    text = _read_text_from_zip(nested, inner_name)
                    out.write(text)
                    if not text.endswith("\n"):
                        out.write("\n")

        outer.close()

    print("Wrote DEW audit process log to: %s" % log_path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
