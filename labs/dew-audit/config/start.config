GLOBAL_SETTINGS
    GRADE_CONTAINER audit
    HOST_HOME_XFER labtainer_xfer/
    LAB_MASTER_SEED dew_audit_2026_master_seed
    COLLECT_DOCS YES

NETWORK dew-audit-net
    MASK 172.25.30.0/24
    GATEWAY 172.25.30.1

CONTAINER audit
    TERMINALS 1
    REGISTRY doanhduc536
    USER ubuntu
    PASSWORD ubuntu
    dew-audit-net 172.25.30.10
    ADD-HOST verifier:172.25.30.20

CONTAINER verifier
    TERMINALS 1
    REGISTRY doanhduc536
    USER ubuntu
    PASSWORD ubuntu
    dew-audit-net 172.25.30.20
    ADD-HOST audit:172.25.30.10
