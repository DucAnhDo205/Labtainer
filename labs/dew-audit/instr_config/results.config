# results.config
#
# Automated assessment for the DEW audit-video Labtainer.

# Standard grading results from the student workstation.
_cover_created = audit:submit_dew.py.stdout : CONTAINS : COVER_OK=Y
_embed_bits = audit:submit_dew.py.stdout : CONTAINS : EMBED_BITS=136
_extract_ok = audit:submit_dew.py.stdout : CONTAINS : EXTRACT_OK=Y
_psnr_ok = audit:submit_dew.py.stdout : CONTAINS : PSNR_OK=Y

# Standard grading results from the verifier workstation.
_verifier_original = verifier:run_tests.sh.stdout : CONTAINS : VERIFY_ORIGINAL=Y
_verifier_attacked = verifier:run_tests.sh.stdout : CONTAINS : VERIFY_ATTACKED=Y

# Current-state checkwork feedback.  Students see these messages when a
# checkwork item is still missing or false.
#CHECK_TRUE: cover.dwv was not verified. On audit, run: python make_cover.py; python submit_dew.py
cw_cover_created = audit:submit_dew.py.stdout : CONTAINS : COVER_OK=Y
#CHECK_TRUE: The expected 136 watermark bits were not embedded. On audit, rerun python submit_dew.py.
cw_embed_bits = audit:submit_dew.py.stdout : CONTAINS : EMBED_BITS=136
#CHECK_TRUE: The hidden DEW audit trace did not extract correctly on audit.
cw_extract_ok = audit:submit_dew.py.stdout : CONTAINS : EXTRACT_OK=Y
#CHECK_TRUE: The watermarked video PSNR is below the required threshold.
cw_psnr_ok = audit:submit_dew.py.stdout : CONTAINS : PSNR_OK=Y
#CHECK_TRUE: Verifier did not decode the original watermarked video. Copy watermarked.dwv to verifier and run ./run_tests.sh watermarked.dwv 17 9107.
cw_verifier_original = verifier:run_tests.sh.stdout : CONTAINS : VERIFY_ORIGINAL=Y
#CHECK_TRUE: Verifier did not decode the attacked video. Rerun ./run_tests.sh watermarked.dwv 17 9107 on verifier.
cw_verifier_attacked = verifier:run_tests.sh.stdout : CONTAINS : VERIFY_ATTACKED=Y
#CHECK_OK: All DEW audit-video checkwork items pass.
