# goals.config
#
# Final instructor-facing goals for the DEW audit-video lab.

# DOC: Student created the cover video, embedded the DEW audit trace, extracted
# the expected message, and kept visual distortion within the PSNR threshold.
dew_audit_workstation_complete = boolean : ( _cover_created and _embed_bits and _extract_ok and _psnr_ok )

# DOC: Verifier workstation validated both the original watermarked video and
# the compression-like attacked video.
dew_audit_verifier_complete = boolean : ( _verifier_original and _verifier_attacked )

# DOC: Full DEW audit-video Labtainer completion.
dew_audit_lab_complete = boolean : ( dew_audit_workstation_complete and dew_audit_verifier_complete )
