# goals.config
#
# Public checkwork goals for the DEW audit-video lab.

# DOC: Cover video was created and checked on audit.
cover = boolean : _cover_created

# DOC: The expected 136 DEW watermark bits were embedded.
embed = boolean : _embed_bits

# DOC: The hidden message extracts as DEW-AUDIT-TRACE26 on audit.
extract = boolean : _extract_ok

# DOC: The watermarked video keeps PSNR at or above 30 dB.
psnr = boolean : _psnr_ok

# DOC: Verifier decodes the copied watermarked video.
verifier_original = boolean : _verifier_original

# DOC: Verifier decodes the watermarked video after the mild attack.
verifier_attacked = boolean : _verifier_attacked

# DOC: All DEW audit lab requirements are complete.
complete = boolean : ( cover and embed and extract and psnr and verifier_original and verifier_attacked )
